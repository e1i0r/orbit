# Binaries and build artifacts
/orbit
/dist/
*.out
*.log

# Coverage
.coverage/

# OS and IDE configuration
.DS_Store
.idea/
# The directory's contents, not the directory itself: git never looks inside
# a directory it has excluded, so an exception under `.vscode/` would never
# be read.
.vscode/*
# ...except the two files that make the editor and the linter agree: which
# formatter runs on save is a fact about the project, not a preference, and
# the extension that runs it has to be installed for the setting to mean
# anything.
!.vscode/settings.json
!.vscode/extensions.json

# Local agent artifacts & superpowers
.claude/
.superpowers/

# Working notes: the design, the plans and the session handoff are kept
# alongside the code but are not published with it. The two files the README
# links to are the exception, so a clone does not land on dead links.
/docs/*
!/docs/engines.md
!/docs/cockpit.md
/NEXT.md
site/install.sh

# A literal ~ directory, made by a make install whose PREFIX was quoted so
# the shell never expanded it. The 24MB binary that landed there was
# committed once; this keeps the next slip out of the tree.
~/
