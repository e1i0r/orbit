node_modules

# dist is committed on purpose, and this is the line Vite's scaffold put
# here to ignore it. See ui/embed.go: `go build` reads ui/dist, and a Go
# project that needs npm to compile is a Go project that does not build.
# `make ui` is what writes it.
dist-ssr
